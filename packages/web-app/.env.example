# Optional. The extension auto-announces its ID to this origin, so you normally
# do NOT need to set this. Use it only to force a specific extension ID.
VITE_EXTENSION_ID=

# Optional OAuth client IDs (token-based auth works without these).
VITE_LINEAR_CLIENT_ID=
VITE_JIRA_CLIENT_ID=

# --- Firebase (all optional; the built-in config targets the `repruvia` project) ---
# Use the local emulator suite (`pnpm emulators`) for Auth and Cloud Firestore.
VITE_FIREBASE_EMULATORS=
# reCAPTCHA Enterprise site key — turns on App Check (keeps calls that don't
# come from this app off the Firestore quota). In dev, the console prints a
# debug token to register.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
